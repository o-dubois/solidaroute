# SolidaRoute — Test environment template
# Copy to backend/.env.test and fill in your local test values.
# NEVER commit backend/.env.test — it contains real credentials.

NODE_ENV=test
PORT=4001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4001

# Test database (create with: createdb solidaroute_test)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solidaroute_test
DB_USER=solidaroute
DB_PASSWORD=CHANGE_ME

# JWT — any random string works for tests
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# Routing (tests skip OSRM/Addok if unreachable)
OSRM_URL=http://localhost:5001
ADDOK_URL=http://localhost:7878

# Stripe test key (sk_test_... from your Stripe dashboard)
STRIPE_SECRET_KEY=CHANGE_ME

# Document encryption key — 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=CHANGE_ME

# Writable temp path for uploaded documents during tests
UPLOADS_DIR=/tmp/solidaroute-test-uploads

# SMTP — email is mocked in tests; these values are never used
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=SolidaRoute Test <noreply@solidaroute.ca>
SMTP_REJECT_UNAUTHORIZED=false
