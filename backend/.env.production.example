# SolidaRoute — Production environment template
# Copy to backend/.env and fill in every value before starting the server.
# NEVER commit the real .env to git.

NODE_ENV=production
PORT=4000

# Your domain (no trailing slash, no path)
FRONTEND_URL=https://drivers4u.online
BACKEND_URL=https://drivers4u.online

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solidaroute
DB_USER=solidaroute
# Use a strong random password: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# DO NOT CHANGE after users have logged in — all sessions will be invalidated.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ── Routing ───────────────────────────────────────────────────────────────────
OSRM_URL=http://localhost:5001
ADDOK_URL=http://localhost:7878

# ── Payment ───────────────────────────────────────────────────────────────────
# 'stripe' | 'manual' | 'mobility' | 'pending'
PAYMENT_PROVIDER=manual
# STRIPE_SECRET_KEY=sk_live_...   (use sk_test_ for demo)

# ── SMTP Email ────────────────────────────────────────────────────────────────
# Brevo (free 300/day): smtp-relay.brevo.com:587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=SolidaRoute <noreply@drivers4u.online>
SMTP_REJECT_UNAUTHORIZED=false
